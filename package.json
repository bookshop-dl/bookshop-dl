{
  "name": "bookshop-dl",
  "private": true,
  "workspaces": [
    "lib",
    "scripts",
    "app"
  ],
  "scripts": {
    "build:lib": "npm run build -w bookshop-lib",
    "list-library": "npm run list-library -w bookshop-dl-scripts",
    "download-epub": "npm run download-epub -w bookshop-dl-scripts",
    "app": "npm run start -w bookshop-dl-app",
    "app:dist": "npm run build -w bookshop-lib && npm run dist -w bookshop-dl-app"
  }
}
